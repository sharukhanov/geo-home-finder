# Copy to .env and adjust as needed. All values have sensible defaults.

# Port the server listens on (API + client served together).
PORT=5000

# Which engine computes zones and routes. Implementations live in
# server/providers/ — add one there to move off 2GIS.
# GEO_PROVIDER=2gis

# Enables GET /api/feedback for reading collected feedback. Without it the
# endpoint returns 404, so feedback is never public. Pick a long secret.
# ADMIN_TOKEN=

# --- Travel-time zones (2GIS Isochrone API) ---
# When set, zones are computed from real travel times (public transport / car /
# walking) via 2GIS. When unset, the app falls back to an approximate estimate.
# DGIS_API_KEY=your-2gis-key
# Overrides the Isochrone API endpoint. Only needed for tests, to point the
# provider at a stub instead of the real 2GIS.
# DGIS_ISOCHRONE_URL=https://routing.api.2gis.com/isochrone/2.0.0

# --- Geocoding (OpenStreetMap Nominatim by default) ---
# Base URL of the geocoding provider. Point this at a self-hosted Nominatim
# or a commercial provider to avoid the public-instance rate limits.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# Nominatim requires a real identifying User-Agent with a contact address.
GEOCODER_USER_AGENT=Fatera/1.0 (housing-optimizer; contact: you@example.com)

# Bias and language for results (comma-separated ISO country codes).
GEOCODER_COUNTRY_CODES=ru
GEOCODER_LANGUAGE=ru

# Keep suggestions near the city instead of returning hits from all of Russia.
# Defaults below are Moscow; change them when adding another city.
# GEOCODER_BIAS_LAT=55.7558
# GEOCODER_BIAS_LON=37.6176
# GEOCODER_BIAS_RADIUS=40000
# Bounding box for the fallback geocoder.
# GEOCODER_VIEWBOX=37.2,55.4,38.0,56.0

# --- Database ---
# When set, the app stores points/zones in PostgreSQL (tables are created
# automatically on startup). When unset, it falls back to in-memory storage.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Set PGSSL=disable to turn off SSL (e.g. for a local Postgres).
# PGSSL=disable
